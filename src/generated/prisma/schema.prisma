datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ON_SITE
}

enum ExperienceLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  FIRST_CALL
  SCREENING
  SHORTLISTED
  INTERVIEW
  ASSESSMENT
  HIRED
  SELECTED
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(RECRUITER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes         ApplicationNote[]
  statusHistory ApplicationStatusHistory[]

  @@map("users")
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String // e.g. "Founder & CEO", "Lead Systems Architect", "Head of Design"
  department  String   @default("Core Team") // "Leadership", "Engineering", "Design", "Advisors"
  avatarUrl   String // Image URL
  bio         String?  @db.Text
  linkedInUrl String?
  twitterUrl  String?
  githubUrl   String?
  order       Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model HeroTechDomain {
  id           String   @id @default(cuid())
  title        String // e.g. "AI Agents & Intelligence"
  shortTitle   String // e.g. "AI Agents"
  slug         String   @unique // e.g. "ai-agents"
  icon         String   @default("Brain") // "Brain", "Globe", "Smartphone", "Cloud", "Workflow", "Cpu", etc.
  color        String   @default("purple") // "purple", "blue", "cyan", "amber", "emerald", "rose"
  position     String   @default("top") // "top", "top-right", "bottom-right", "bottom-left", "top-left"
  description  String?  @db.Text
  technologies String[] @default([])
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hero_tech_domains")
}

model Candidate {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  headline       String? // e.g. "Frontend Engineer & 3rd Year CSE @ DTU"
  avatarUrl      String?
  phone          String?
  location       String? // e.g. "New Delhi, India"
  collegeName    String?
  degree         String?
  branch         String?
  graduationYear Int?
  cgpa           String?
  currentYear    String?
  resumeUrl      String?
  skills         String[] @default([])
  projects       Json?    @default("[]")
  linkedInUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  twitterUrl     String?
  bio            String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications Application[]

  @@map("candidates")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?  @default("Core") // "Frontend", "Backend", "AI/ML", "Design", "DevOps", "Mobile", "Core"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String? // e.g. "Cpu", "Layout", "TrendingUp", "Sparkles"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@map("departments")
}

model Job {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  location        String // e.g., "Remote", "Bengaluru, India"
  workplaceType   WorkplaceType   @default(REMOTE)
  employmentType  EmploymentType  @default(INTERNSHIP)
  experienceLevel ExperienceLevel @default(ENTRY_LEVEL)
  salaryRange     String? // e.g. "₹25,000 - ₹45,000 / month Stipend" or "$80k - $120k"
  imageUrl        String? // Job Cover Banner / Role Visual Image URL
  skills          String[]        @default([]) // Tech stack & skill badges (e.g. Next.js, React, TypeScript)

  aboutRole        String   @db.Text
  responsibilities String[] // List of responsibilities
  requirements     String[] // List of requirements
  niceToHave       String[] @default([])
  benefits         String[] @default([])
  hiringProcess    String[] @default([])

  status     JobStatus @default(PUBLISHED)
  deadline   DateTime?
  viewsCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  applications Application[]

  @@index([departmentId])
  @@index([status])
  @@index([slug])
  @@map("jobs")
}

model Application {
  id          String     @id @default(cuid())
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  fullName String
  email    String
  phone    String

  // College Student & Graduate details
  collegeName    String?
  degree         String? // e.g. "B.Tech", "BCA", "MCA", "B.Des"
  branch         String? // e.g. "Computer Science", "Information Technology"
  graduationYear Int? // e.g. 2025, 2026, 2027
  cgpa           String? // e.g. "8.4 CGPA" or "85%"
  currentYear    String? // e.g. "3rd Year", "Final Year", "Recent Graduate"

  resumeUrl      String // Google Drive, Dropbox, Notion, or hosted resume link
  resumeFileName String? // Optional label or provider name
  resumeFileSize Int? // Optional size if applicable

  linkedInUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  skills             String[] @default([])
  projects           Json?    @default("[]")
  coverLetter        String?  @db.Text
  relevantExperience String?  @db.Text
  additionalInfo     String?  @db.Text
  consentGiven       Boolean  @default(true)

  // Status & Hiring decision workflow
  status             ApplicationStatus @default(APPLIED)
  firstCallNotes     String?           @db.Text
  firstCallScheduled DateTime?

  // Official Offer Letter Details
  offerSalary        String? // e.g. "₹45,000 / Month Stipend" or "₹14 LPA"
  offerJoiningDate   String? // e.g. "15th October 2026"
  offerLocation      String? // e.g. "Remote (India)" or "Bengaluru HQ"
  offerTerms         String?   @db.Text
  offerProbation     String?
  offerWorkingHours  String?
  offerNoticePeriod  String?
  offerSignatory     String?
  offerSignatureName String?
  offerRefNo         String?
  offerPdfUrl        String?
  offerSentAt        DateTime?
  offerAcceptedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory ApplicationStatusHistory[]
  notes         ApplicationNote[]
  emails        EmailNotification[]

  @@unique([jobId, email])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model ApplicationStatusHistory {
  id             String            @id @default(cuid())
  applicationId  String
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus ApplicationStatus
  newStatus      ApplicationStatus
  changedById    String
  changedBy      User              @relation(fields: [changedById], references: [id])
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([applicationId])
  @@map("application_status_history")
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  content       String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@map("application_notes")
}

model EmailNotification {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recipient     String
  stage         ApplicationStatus
  subject       String
  bodyText      String            @db.Text
  bodyHtml      String            @db.Text
  status        String            @default("SENT") // "SENT" | "SIMULATED" | "FAILED"
  sentAt        DateTime          @default(now())

  @@index([applicationId])
  @@index([recipient])
  @@index([stage])
  @@map("email_notifications")
}

model EmailTemplate {
  id             String            @id @default(cuid())
  stage          ApplicationStatus @unique
  subject        String
  headline       String
  introParagraph String            @db.Text
  actionCallout  String?           @db.Text
  mainContent    String            @db.Text
  nextSteps      String[]          @default([])
  ctaText        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("email_templates")
}

model OfferLetterSettings {
  id                    String @id @default("default")
  companyName           String @default("iZies Technologies Private Limited")
  cin                   String @default("U72900DL2024PTC098712")
  registeredOffice      String @default("Innovation Building, Cyber Hub, DLF Phase 2, Gurugram, India") @db.Text
  rdCampus              String @default("Outer Ring Road, Bengaluru, Karnataka, India") @db.Text
  defaultSalary         String @default("Unpaid (Experience & Certificate of Completion)")
  defaultJoiningDate    String @default("1st October 2026")
  defaultLocation       String @default("Remote (India)")
  defaultEmploymentType String @default("Unpaid Internship / Apprenticeship")
  defaultProbation      String @default("Three (3) Months from Date of Joining")
  defaultWorkingHours   String @default("Flexible (20–40 Hours / Week with Core Collaboration Windows)")
  defaultNoticePeriod   String @default("Fifteen (15) Days written notice")
  defaultSignatory      String @default("Core Executive Leadership Team")
  defaultSignatoryTitle String @default("Talent Operations & Technology Architecture")
  defaultSpecialTerms   String @default("1-on-1 Engineering Mentorship, Official Experience Certificate on Corporate Letterhead, Milestone LOR, and Fast-Track PPO Evaluation.") @db.Text

  // Theme, Styling & Watermark
  themeStyle       String @default("modern-indigo")
  themeAccentColor String @default("#1E40AF")
  themeFontFamily  String @default("inter")
  themeWatermark   String @default("confidential")

  // Narrative, Headers & Declarations
  headerTagline         String @default("LETTER OF APPOINTMENT & FORMAL OFFER OF EMPLOYMENT")
  confidentialityBadge  String @default("STRICTLY PRIVATE & CONFIDENTIAL")
  introParagraph        String @default("We are pleased to formally extend this offer of appointment at iZies Technologies Private Limited. Our leadership team has been thoroughly impressed by your technical depth, problem-solving craft, and alignment with our vision to build world-class digital platforms.") @db.Text
  acceptanceDeclaration String @default("I hereby acknowledge receipt of this formal Letter of Appointment, along with Annexures A & B. I confirm that I have read, understood, and willingly accept all terms, compensation structures, governance policies, and conditions contained herein. I confirm my acceptance of this offer and commit to joining on the scheduled date.") @db.Text
  signatoryHeading      String @default("For and on behalf of iZies Technologies Private Limited")
  footerNotice          String @default("This document constitutes a binding corporate appointment contract upon bilateral signature. All rights reserved.") @db.Text

  // Core Members (Name, Role, Email)
  coreMembers    Json?    @default("[]")
  rules          Json?    @default("[]")
  annexureAItems Json?    @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("offer_letter_settings")
}

model SystemSetting {
  id        String   @id @default("default")
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  smtpPass  String?
  fromEmail String?
  updatedAt DateTime @updatedAt

  // Company Profile & Social Links
  contactEmail  String?
  contactPhone  String?
  officeAddress String? @db.Text
  linkedinUrl   String?
  twitterUrl    String?
  githubUrl     String?
  instagramUrl  String?
  globeUrl      String?

  @@map("system_settings")
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

model ContactInquiry {
  id          String        @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  companyName String?
  service     String?       @default("AI Solution")
  budget      String?
  description String?       @db.Text
  status      InquiryStatus @default(NEW)
  source      String        @default("website_contact")
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model IziesProduct {
  id          String   @id @default(cuid())
  name        String
  tagline     String
  description String   @db.Text
  type        String   @default("Free") // "Free", "Open Source", "Freemium", "Paid", "Free · Open Source"
  status      String   @default("in_development") // "live", "beta", "in_development", "coming_soon"
  url         String?
  imageUrl    String? // Screenshot / cover image URL
  iconName    String? // Lucide icon name e.g. "Rocket", "Globe", "Sparkle"
  color       String?  @default("indigo") // "indigo", "cyan", "purple", "violet", "blue"
  tags        String[] @default([]) // ["Students", "Collaboration", "Open Platform"]
  services    String[] @default([]) // capability mapping
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([order])
  @@map("izies_products")
}

model ClientProject {
  id          String    @id @default(cuid())
  name        String
  clientName  String
  industry    String
  description String    @db.Text
  challenge   String?   @db.Text
  solution    String?   @db.Text
  result      String?   @db.Text
  techStack   String[]  @default([]) // ["React", "Node.js", "AWS"]
  services    String[]  @default([]) // ["Web Development", "UI/UX Design"]
  imageUrl    String? // Screenshot or cover image
  websiteUrl  String?
  startDate   DateTime?
  endDate     DateTime?
  isFeatured  Boolean   @default(false)
  order       Int       @default(0)
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isFeatured])
  @@index([order])
  @@map("client_projects")
}
